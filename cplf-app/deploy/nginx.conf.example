# Contoh konfigurasi Nginx — reverse proxy API + static (jika perlu)
# Salin ke /etc/nginx/sites-available/cplf-api dan symlink ke sites-enabled

upstream cplf_api {
    server 127.0.0.1:4000;
    keepalive 32;
}

server {
    listen 80;
    server_name api.cplf.example.com;

    client_max_body_size 50M;

    location / {
        proxy_pass http://cplf_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# FE di Vercel — CORS_ORIGIN di .env BE harus mencantumkan domain Vercel
