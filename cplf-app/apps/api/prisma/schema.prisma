generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MateriStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SoalTipe {
  PILIHAN_GANDA
  ESAI_SINGKAT
  BENAR_SALAH
}

enum SoalTingkat {
  MUDAH
  SEDANG
  SULIT
}

model User {
  id                 String     @id @default(uuid())
  username           String     @unique
  passwordHash       String
  mustChangePassword Boolean    @default(true)
  nama               String
  email              String?    @unique
  fotoProfilUrl      String?
  status             UserStatus @default(ACTIVE)
  tokenVersion       Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roles          UserRole[]
  profilSiswa    ProfilSiswa?
  profilGuru     ProfilGuru?
  refreshTokens  RefreshToken[]
  guruMapelKelas GuruMapelKelas[]
  kelasWali      Kelas[]        @relation("WaliKelas")
  materiDibuat   Materi[]       @relation("MateriCreator")
  soalDibuat     Soal[]         @relation("SoalCreator")
}

model Role {
  id          String           @id @default(uuid())
  kode        String           @unique
  nama        String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  kode  String           @unique
  nama  String?
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Kelas {
  id          String           @id @default(uuid())
  nama        String
  tingkat     String
  tahunAjaran String
  waliKelasId String?
  siswa       ProfilSiswa[]
  guruMapel   GuruMapelKelas[]
  waliKelas   User?            @relation("WaliKelas", fields: [waliKelasId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Mapel {
  id        String           @id @default(uuid())
  nama      String
  kode      String           @unique
  temas     Tema[]
  guruMapel GuruMapelKelas[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model GuruMapelKelas {
  id      String @id @default(uuid())
  guruId  String
  mapelId String
  kelasId String
  guru    User   @relation(fields: [guruId], references: [id], onDelete: Cascade)
  mapel   Mapel  @relation(fields: [mapelId], references: [id], onDelete: Cascade)
  kelas   Kelas  @relation(fields: [kelasId], references: [id], onDelete: Cascade)

  @@unique([guruId, mapelId, kelasId])
}

model Tema {
  id                 String   @id @default(uuid())
  mapelId            String
  judul              String
  urutan             Int
  semester           Int
  tingkat            String
  urutanGlobal       Int
  kodeModulCplf      String   @unique
  slug               String   @unique
  deskripsi          String?
  capabilityCodes    String[]
  aspekFormatifFokus String[]
  expCodes           String[]
  prjCodes           String[]
  unitSilabus        String?
  isProjectPertemuan Boolean  @default(false)
  mapel              Mapel    @relation(fields: [mapelId], references: [id], onDelete: Cascade)
  materi             Materi[]
  soal               Soal[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Materi {
  id          String       @id @default(uuid())
  temaId      String
  judul       String
  slug        String       @unique
  contentJson Json         @default("{\"blocks\":[]}")
  status      MateriStatus @default(DRAFT)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tema        Tema         @relation(fields: [temaId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("MateriCreator", fields: [createdById], references: [id])
}

model Soal {
  id               String       @id @default(uuid())
  temaId           String
  tipe             SoalTipe
  pertanyaan       String
  pertanyaanJson   Json?
  tingkatKesulitan SoalTingkat  @default(SEDANG)
  tags             String[]
  createdById      String
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tema             Tema         @relation(fields: [temaId], references: [id], onDelete: Cascade)
  createdBy        User         @relation("SoalCreator", fields: [createdById], references: [id])
  pilihan          PilihanJawaban[]
}

model PilihanJawaban {
  id      String  @id @default(uuid())
  soalId  String
  teks    String
  isBenar Boolean @default(false)
  urutan  Int
  soal    Soal    @relation(fields: [soalId], references: [id], onDelete: Cascade)
}

model CapabilityDef {
  id           String   @id @default(uuid())
  kode         String   @unique
  tingkat      String
  domain       String
  deskripsi    String
  aspekTerkait String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProfilSiswa {
  id             String  @id @default(uuid())
  userId         String  @unique
  nis            String  @unique
  kelasId        String?
  urlGit         String?
  kontakOrangTua String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kelas          Kelas?  @relation(fields: [kelasId], references: [id])
}

model ProfilGuru {
  id     String  @id @default(uuid())
  userId String  @unique
  nip    String? @unique
  bidang String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
