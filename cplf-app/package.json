{
  "name": "cplf-app",
  "private": true,
  "version": "0.1.0",
  "description": "CPLF LMS — FE (Vercel) + BE (VPS native)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "dev": "npx concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build -w api && npm run build -w web",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:generate": "npm run db:generate -w api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
